# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase Cloud Messaging (device agent push commands)
# Paste the full service-account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON=

# Shared secret the Android agent app uses to authenticate location/status pings
DEVICE_AGENT_API_KEY=

# Protects the overdue-check cron endpoint (Vercel Cron sends this header)
CRON_SECRET=

# Days after due date before auto-lock fires
EMI_GRACE_PERIOD_DAYS=3
